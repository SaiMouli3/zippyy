# Copy to .env for local (non-Docker) runs; docker-compose.yml sets equivalents for the containers.
DATABASE_URL=postgresql://zippy:zippy@localhost:5432/zippy
REDIS_URL=redis://localhost:6379/0

# Carrier endpoints (mock carriers are served by the API itself under /mock/<carrier>)
CARRIER_BASE_URL=http://127.0.0.1:8000
FASTSHIP_BASE_URL=http://127.0.0.1:8000/mock/fastship
QUICKEXPRESS_BASE_URL=http://127.0.0.1:8000/mock/quickexpress
RELIABLE_BASE_URL=http://127.0.0.1:8000/mock/reliable
WEBHOOK_BASE_URL=http://127.0.0.1:8000        # where mock carriers POST webhooks

CARRIER_TIMEOUT_MS=3000          # per carrier request
RATE_CACHE_TTL=300               # seconds, complete rate results
PARTIAL_RATE_CACHE_TTL=60        # seconds, results missing >=1 carrier

DEFAULT_MERCHANT_ID=MER-DEMO
SEED_DEMO=true                   # create the demo merchant/order/shipment on first start
MAX_AUTO_RESCHEDULE_DAYS=2
LOG_LEVEL=INFO
