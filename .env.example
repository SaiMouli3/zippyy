# Copy to .env to override docker-compose defaults. None of these are real secrets; replace for any shared environment.

# --- PostgreSQL ---
POSTGRES_USER=zippy
POSTGRES_PASSWORD=zippy
POSTGRES_DB=zippy
# Used when running the API outside Docker:
DATABASE_URL=postgres://zippy:zippy@localhost:5432/zippy?sslmode=disable

# --- Redis (rate cache) ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300            # TTL for complete rate results
CACHE_PARTIAL_TTL_SECONDS=30     # shorter TTL when a carrier failed (partial result)

# --- Carriers (mock carriers in dev; each may be a separate host) ---
FASTSHIP_BASE_URL=http://localhost:9000
QUICKEXPRESS_BASE_URL=http://localhost:9000
RELIABLECOURIER_BASE_URL=http://localhost:9000
CARRIER_TIMEOUT_MS=3000
ZIPPY_PUBLIC_URL=http://localhost:8080   # how carriers reach Zippy for webhooks

# --- Webhook authentication (HMAC-SHA256 of the raw body, header X-Carrier-Signature) ---
WEBHOOK_SIGNATURE_REQUIRED=true
FASTSHIP_WEBHOOK_SECRET=dev-fastship-secret
QUICKEXPRESS_WEBHOOK_SECRET=dev-quickexpress-secret
RELIABLE_WEBHOOK_SECRET=dev-reliable-secret

# --- NDR agent ---
LLM_PROVIDER=mock                # only "mock" ships; real providers plug into agent.LLMProvider
INTENT_CONFIDENCE_MIN=0.75       # below this the agent asks the buyer to confirm instead of acting
NDR_CONTACT_TIMEOUT=14400        # seconds, fallback buyer response timeout
NDR_AUTO_CONTACT=false           # true = contact the buyer automatically when an NDR arrives
NDR_SWEEP_INTERVAL_SECONDS=60    # background no-response sweeper

# --- Misc ---
SEED_DEMO=true                   # seed demo orders (MERCHANT-09001..3) on boot
LOG_LEVEL=info
PORT=8080
CORS_ALLOWED_ORIGINS=*
