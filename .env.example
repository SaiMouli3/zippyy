# Copy to .env (docker compose and the backend read it). Never commit .env.
# Every value below has a safe development default; APP_ENV=production refuses to start until the secrets are set.

# --- Runtime -----------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database & cache ----------------------------------------------------------
POSTGRES_USER=zippy
POSTGRES_PASSWORD=zippy
POSTGRES_DB=zippy
# Outside docker:
# DATABASE_URL=postgresql+psycopg://zippy:zippy@localhost:5432/zippy
# REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Security (REQUIRED in production) ------------------------------------------
# Generate with: python -c "import secrets,base64;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PII_ENCRYPTION_KEY=
PII_HASH_KEY=
VOICE_WEBHOOK_SECRET=
SESSION_COOKIE_SECURE=false         # must be true behind HTTPS (enforced in production)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=http://localhost:3000
LEGACY_SANDBOX_ENABLED=true         # MVP booking API + mock carriers; set false in production
ALLOW_DEMO_SEED=true                # set false in production

# --- Public URLs -----------------------------------------------------------------
# Where providers call back (Sarvam voice callbacks need the public HTTPS origin of the API).
ZIPPY_PUBLIC_URL=http://localhost:8000
CARRIER_BASE_URL=http://localhost:8000
# Frontend: the API origin the Next.js server proxies /api/v1 to (build time) ...
BACKEND_URL=http://localhost:8000
# ... and the browser-visible API origin used only by the legacy /orders and /mock pages.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Carriers ----------------------------------------------------------------------
CARRIER_WEBHOOK_SIGNATURE_REQUIRED=false   # set true in production (HMAC-SHA256 in X-Carrier-Signature)
CARRIER_WEBHOOK_SECRET_FASTSHIP=
CARRIER_WEBHOOK_SECRET_QUICKEXPRESS=
CARRIER_WEBHOOK_SECRET_RELIABLE=
CARRIER_RATE_TIMEOUT_SECONDS=2.5
CARRIER_BOOKING_TIMEOUT_SECONDS=5
CARRIER_ACTION_TIMEOUT_SECONDS=6
RATE_CACHE_TTL_SECONDS=300

# --- WhatsApp (Meta Cloud API) -----------------------------------------------------
WHATSAPP_PROVIDER=simulator         # simulator | meta_cloud
META_GRAPH_API_VERSION=v21.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=                    # verifies X-Hub-Signature-256 on inbound webhooks
META_VERIFY_TOKEN=                  # echoed during webhook subscription

# --- Voice & language (Sarvam) --------------------------------------------------------
VOICE_PROVIDER=simulator            # simulator | sarvam_agents
SARVAM_API_KEY=                     # api.sarvam.ai: speech, language id, chat completions
SARVAM_AGENTS_API_KEY=              # apps.sarvam.ai workspace key
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=0
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
PROVIDER_TIMEOUT_SECONDS=8
INTENT_EXTRACTOR=rules              # rules | sarvam_llm | openai_compatible (falls back to rules on any failure)
SARVAM_LLM_MODEL=sarvam-105b
# Any OpenAI-compatible chat-completions API (LLM gateways, hosted models), used when INTENT_EXTRACTOR=openai_compatible
LLM_BASE_URL=                       # endpoint root, e.g. https://<provider>/v1 (Zippyy calls {LLM_BASE_URL}/chat/completions)
LLM_API_KEY=                        # sent as Authorization: Bearer
LLM_MODEL=
LANGUAGE_DETECTOR=heuristic         # heuristic | sarvam

# --- Worker ------------------------------------------------------------------------
WORKER_POLL_SECONDS=1.0
WORKER_BATCH_SIZE=20
JOB_LEASE_SECONDS=120
MAX_CONCURRENT_CALLS_PER_MERCHANT=10

# --- Demo seed (local only) ------------------------------------------------------------
# DEMO_PASSWORD=                    # if unset, the seed prints a random password once
