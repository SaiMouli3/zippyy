# Copy to .env (docker compose reads it automatically). Everything has a working default.
POSTGRES_USER=zippy
POSTGRES_PASSWORD=zippy
POSTGRES_DB=zippy

# Browser-visible URL of the backend (baked into the frontend image at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Carrier call budgets (seconds). Rates are read-only and retry-safe, so the budget is tight.
CARRIER_RATE_TIMEOUT_SECONDS=2.5
CARRIER_BOOKING_TIMEOUT_SECONDS=5
RATE_CACHE_TTL_SECONDS=300

# Backend-only settings (see backend/app/config.py) when running without docker:
# DATABASE_URL=postgresql+psycopg://zippy:zippy@localhost:5432/zippy
# REDIS_URL=redis://localhost:6379/0
# CARRIER_BASE_URL=http://localhost:8000
# ZIPPY_PUBLIC_URL=http://localhost:8000
# AGENT_PROVIDER=rule_based
